# PostgreSQL connection string. Use a dedicated database and least-privilege credentials.
DATABASE_URL=postgres://procura_app:change-me@localhost:5432/procura
# Set to true only behind HTTPS.
COOKIE_SECURE=false
# Exact frontend origin, e.g. http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
# Optional one-time platform admin bootstrap secret (at least 24 random characters).
# Remove after creating the first Platform Admin.
BOOTSTRAP_ADMIN_KEY=
