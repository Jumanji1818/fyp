{
  "name": "procura",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync android",
    "build:desktop": "cross-env ELECTRON=1 vite build",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "cross-env": "^7.0.3"
  },
  "description": "Procura - Smart Procurement System (desktop)",
  "author": "Abdulhameed Abdulsalam",
  "main": "electron/main.cjs",
  "build": {
    "appId": "ng.procura.desktop",
    "productName": "Procura",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/*.apk",
      "!dist/*.docx",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "public/icon-square.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Procura-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Procura-Portable-${version}.${ext}"
    }
  }
}
